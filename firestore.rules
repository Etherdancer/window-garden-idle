rules_version = '2';

// Suggested rules for Cloud Firestore. The app only uses saves/{uid}; each signed-in user
// may read and write their own save document and nothing else. The notification worker
// uses a service account, which bypasses these rules.
//
// Review against the rules currently deployed in the Firebase console, then deploy with:
//   firebase deploy --only firestore:rules
// (add "firestore": { "rules": "firestore.rules" } to firebase.json first).
service cloud.firestore {
  match /databases/{database}/documents {
    match /saves/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
